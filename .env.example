DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ameris
HOST=0.0.0.0
PORT=3000
AUTH_TRUST_HOST=true
# Optional: set these only when you need a fixed public URL or a custom domain.
# NEXTAUTH_URL=http://192.168.1.10:3000
# NEXT_PUBLIC_SITE_URL=http://192.168.1.10:3000
# The subscriber account whose public site this is (resources page, contact
# form notifications). Defaults to Ameris Academy.
# PUBLIC_SITE_ACCOUNT=C-1001
NEXTAUTH_SECRET=replace-with-strong-random-secret
JWT_SECRET=replace-with-strong-random-secret

# Ameris Solutions online enrollment (Stripe Checkout). Use sk_test_/pk_test_
# keys until going live. The webhook (Stripe > Developers > Webhooks) points at
# https://<your site>/api/v1/solutions/stripe-webhook for checkout.session.completed;
# its signing secret goes in STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends people back after paying (defaults to NEXTAUTH_URL).
# PUBLIC_SITE_URL=https://amerissolutions.com

# DocuSign e-signing for centers at enrollment (JWT). From DocuSign Apps and Keys:
# integration key, user ID, API account ID. Generate an RSA keypair there and
# save the private key as a file (never commit it). Give consent once by
# opening https://<auth server>/oauth/auth?response_type=code&scope=signature%20impersonation&client_id=<key>&redirect_uri=<a registered redirect URI>
# Demo: base URI https://demo.docusign.net, auth server account-d.docusign.com.
# Live (after DocuSign go-live): your account's base URI, auth server account.docusign.com.
# Without these, centers use the "I agree" box like Home Daycare.
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_BASE_URI=https://demo.docusign.net
# DOCUSIGN_AUTH_SERVER=account-d.docusign.com
# DOCUSIGN_PRIVATE_KEY_PATH=docusign-private.key
