DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ameris
HOST=0.0.0.0
PORT=3000
AUTH_TRUST_HOST=true
# Optional: set these only when you need a fixed public URL or a custom domain.
# NEXTAUTH_URL=http://192.168.1.10:3000
# NEXT_PUBLIC_SITE_URL=http://192.168.1.10:3000
# The subscriber account whose public site this is (resources page, contact
# form notifications). Defaults to Ameris Academy.
# PUBLIC_SITE_ACCOUNT=C-1001
NEXTAUTH_SECRET=replace-with-strong-random-secret
JWT_SECRET=replace-with-strong-random-secret

# Ameris Solutions online enrollment (Stripe Checkout). Use sk_test_/pk_test_
# keys until going live. The webhook (Stripe > Developers > Webhooks) points at
# https://<your site>/api/v1/solutions/stripe-webhook for checkout.session.completed;
# its signing secret goes in STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe sends people back after paying (defaults to NEXTAUTH_URL).
# PUBLIC_SITE_URL=https://amerissolutions.com
