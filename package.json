{
  "name": "ameris-child-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "build": "node scripts/clean-next-dist.mjs && next build",
    "start": "node server.js --prod",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "import:steps-library": "node scripts/import-steps-library.mjs",
    "normalize:lesson-categories": "node scripts/normalize-lesson-categories.mjs",
    "normalize:curriculum-subjects": "node scripts/normalize-curriculum-subjects.mjs",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:api": "npx playwright test --grep @api"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.11.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^2.4.3",
    "next": "13.5.6",
    "next-auth": "^4.22.1",
    "pg": "^8.10.0",
    "postcss": "^8.5.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^3.7.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.17",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prisma": "^5.11.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
