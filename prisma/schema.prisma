generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  OTHER_STAFF
  PARENT
  COACH
  SUBSCRIBER
}

enum ActivityType {
  DIAPER_CHANGE
  NAP
  BOTTLE
  MEAL
  SNACK
  ACTIVITY
  TASK_CHECKLIST
  BEHAVIOR
  CITIZENSHIP
  ACCOMPLISHMENT
  INCIDENT
  OTHER
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
}

enum OutboundEmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  EMAIL_SENT
}

enum ChecklistPeriod {
  DAY
  WEEK
  MONTH
}

enum MilestoneItemKind {
  POLICY
  PROCEDURE
  VIDEO
  LESSON
  OTHER
}

enum TeacherRecordType {
  CERTIFICATE
  ACHIEVEMENT
  EMPLOYEE_OF_THE_MONTH
  CAREER_LADDER
}

enum NotificationType {
  MESSAGE
  COMPLIANCE_ALERT
  ACTIVITY_UPDATE
  PROGRESS_UPDATE
  SYSTEM
  FORM_RENEWAL
}

enum MessageThreadType {
  MESSAGE
  OPEN_POINT
  REQUEST
  ACCOMMODATION
}

enum MessageThreadStatus {
  OPEN
  READY_FOR_REVIEW
  COMPLETED
}

enum MessagePriorityLevel {
  A
  B
  C
}

enum ArchiveType {
  PROGRESS
  FULL_RECORD
}

enum BehaviorPlanStatus {
  ACTIVE
  CLOSED
  COMPLETED
  ARCHIVED
}

enum ObservationType {
  CAMERA
  IN_CLASS
}

enum FollowUpType {
  PARENT
  CAMERA_OBSERVATION
  GENERAL
}

enum FollowUpStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PermissionType {
  PHOTO_RELEASE
  FIELD_TRIP
  MEDICAL_TREATMENT
  TRANSPORTATION
  SUNSCREEN_APPLICATION
  WATER_ACTIVITIES
  OTHER
}

enum PermissionStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

enum BehaviorGoalStatus {
  NOT_STARTED
  IN_PROGRESS
  MET
  NOT_MET
}

enum StaffAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum TimeOffBalanceType {
  PAID
  UNPAID
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String?
  password           String?
  mustChangePassword Boolean             @default(false)
  dob                DateTime?
  hireDate           DateTime?
  aboutMe            String?
  pictureUrl         String?
  role               Role                @default(PARENT)
  roles              Role[]              @default([])
  centers            CenterUser[]
  children           Child[]
  guardianships      ChildGuardian[]
  teacherClasses     TeacherClass[]
  recordedActivities ActivityLog[]
  threadParticipants ThreadParticipant[]
  sentMessages       Message[]
  createdMessageThreads MessageThread[]      @relation("MessageThreadsCreated")
  completedMessageThreads MessageThread[]    @relation("MessageThreadsCompleted")
  reviewRequestedMessageThreads MessageThread[] @relation("MessageThreadsReviewRequested")
  formSubmissions    FormSubmission[]
  createdInvites     CenterInvite[]      @relation("InvitesCreated")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ProgressEntry      ProgressEntry[]
  AuditLog           AuditLog[]
  OutboundEmail      OutboundEmail[]
  milestoneChecklistCompletions MilestoneChecklistItemCompletion[]
  teacherRecords               TeacherRecord[] @relation("TeacherRecords")
  createdTeacherRecords        TeacherRecord[] @relation("TeacherRecordsCreated")
  notifications                Notification[]            @relation("NotificationsReceived")
  notificationPreferences      NotificationPreference[]  @relation("NotificationPreferences")
  behaviorPlansCreated         BehaviorPlan[]            @relation("BehaviorPlansCreated")
  behaviorPlansClosed          BehaviorPlan[]            @relation("BehaviorPlansClosedBy")
  performanceSnapshots         TeacherPerformanceSnapshot[] @relation("TeacherPerformanceSnapshots")
  staffAttendances             StaffAttendance[]         @relation("StaffAttendances")
  staffAttendancesRecorded     StaffAttendance[]         @relation("StaffAttendancesRecorded")
  timeOffRequests              TimeOffRequest[]          @relation("TimeOffRequests")
  timeOffReviewed              TimeOffRequest[]          @relation("TimeOffReviewed")
  timeOffBalanceEntries        TimeOffBalanceEntry[]     @relation("TimeOffBalanceEntries")
  timeOffBalanceEntriesCreated TimeOffBalanceEntry[]     @relation("TimeOffBalanceEntriesCreated")
  trainingLogs                 TrainingLog[]             @relation("TrainingLogs")
  trainingLogsRecorded         TrainingLog[]             @relation("TrainingLogsRecorded")
  createdTeacherTrainingPathways TeacherTrainingPathway[] @relation("TeacherTrainingPathwaysCreated")
  evaluationsReceived          TeacherEvaluation[]       @relation("EvaluationsReceived")
  evaluationsGiven             TeacherEvaluation[]       @relation("EvaluationsGiven")
  budgetExpensesRecorded       BudgetExpense[]           @relation("BudgetExpensesRecorded")
  permissionsGranted           ChildPermission[]         @relation("PermissionsGranted")
  eventsCreated                Event[]                   @relation("EventsCreated")
  shiftSchedules               ShiftSchedule[]           @relation("ShiftSchedules")
  assignedChecklistItems       MilestoneChecklistItem[]   @relation("ChecklistItemAssignee")
  coachObservationsGiven       CoachObservation[]         @relation("CoachObservationsGiven")
  coachObservationsReceived    CoachObservation[]         @relation("CoachObservationsReceived")
  coachFollowUpsCreated        CoachFollowUp[]            @relation("CoachFollowUpsCreated")
  coachFollowUpsAssigned       CoachFollowUp[]            @relation("CoachFollowUpsAssigned")
  milestoneChecklistStaffCompletions MilestoneChecklistStaffCompletion[] @relation("MilestoneChecklistStaffCompletedBy")
  dailyChecklistCompletions    DailyChecklistCompletion[] @relation("DailyChecklistCompletedBy")
  assignedDailyChecklists      DailyChecklist[]           @relation("DailyChecklistAssignedUser")
  dailyChecklistNotes          DailyChecklistNote[]       @relation("DailyChecklistNotesCreatedBy")
  closedChildFlagReviews       ChildFlagReview[]          @relation("ChildFlagReviewClosedBy")
  parentInvolvements           ParentInvolvement[]
  teacherCommendations         TeacherCommendation[]      @relation("TeacherCommendations")
  teacherCommendationsCreated  TeacherCommendation[]      @relation("TeacherCommendationsCreated")
  teacherCitations             TeacherCitation[]          @relation("TeacherCitations")
  teacherCitationsCreated      TeacherCitation[]          @relation("TeacherCitationsCreated")
}

model Center {
  id               String           @id @default(uuid())
  name             String
  address          String?
  users            CenterUser[]
  classes          ClassRoom[]
  children         Child[]
  attendances      Attendance[]
  lessonCategories LessonCategory[]
  lessons          Lesson[]
  checklists       TaskChecklist[]
  subscription     Subscription?
  messageThreads   MessageThread[]
  formTemplates    FormTemplate[]
  policyDocuments  PolicyDocument[]
  invites          CenterInvite[]
  auditLogs        AuditLog[]
  outboundEmails   OutboundEmail[]
  milestoneChecklistPlans MilestoneChecklistPlan[]
  behaviorPlans    BehaviorPlan[]
  teacherPerformanceSnapshots TeacherPerformanceSnapshot[]
  staffAttendances StaffAttendance[]
  timeOffRequests  TimeOffRequest[]
  timeOffBalanceEntries TimeOffBalanceEntry[]
  trainingLogs     TrainingLog[]
  teacherTrainingPathways TeacherTrainingPathway[]
  staffAdvancements StaffAdvancement[]
  classroomBudgets ClassroomBudget[]
  teacherEvaluations TeacherEvaluation[]
  events           Event[]
  shiftSchedules   ShiftSchedule[]
  affiliates       Affiliate[]
  parentInvolvementActivities ParentInvolvementActivity[]
  coachObservations CoachObservation[]
  coachFollowUps   CoachFollowUp[]
  dailyChecklists  DailyChecklist[]
  lessonTermCalendars LessonTermCalendar[]
  childFlagReviews ChildFlagReview[]
  teacherCommendations TeacherCommendation[]
  teacherCitations     TeacherCitation[]
  performanceGradeConfig PerformanceGradeConfig?
  createdAt        DateTime         @default(now())
}

model CenterUser {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  center   Center @relation(fields: [centerId], references: [id])
  centerId String
  role     Role

  @@unique([userId, centerId])
}

model ClassRoom {
  id       String         @id @default(uuid())
  name     String
  capacity Int?
  ageRange String?
  center   Center         @relation(fields: [centerId], references: [id])
  centerId String
  children Child[]
  attendances Attendance[]
  teachers TeacherClass[]
  budgets  ClassroomBudget[]
  coachObservations CoachObservation[]
  dailyChecklists   DailyChecklist[]
  dailyChecklistAssignments DailyChecklistClassroom[]
  milestoneChecklistPlans MilestoneChecklistPlan[]
}

model TeacherClass {
  id        String    @id @default(uuid())
  teacher   User      @relation(fields: [teacherId], references: [id])
  teacherId String
  classRoom ClassRoom @relation(fields: [classId], references: [id])
  classId   String

  @@unique([teacherId, classId])
}

model Child {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String?
  birthDate       DateTime?
  emergencyContact String?
  emergencyContacts Json?
  parentContacts   Json?
  allergies       String?
  healthAssessmentDocuments Json?
  enrollmentDocuments Json?
  iefDocuments    Json?
  immunizationDocuments Json?
  infantDocuments Json?
  otherDocuments  Json?
  feedingPlan     Json?
  center          Center           @relation(fields: [centerId], references: [id])
  centerId        String
  classRoom       ClassRoom?       @relation(fields: [classRoomId], references: [id])
  classRoomId     String?
  progress        Progress[]
  activities      ActivityLog[]
  attendances     Attendance[]
  completedTasks  ChildTask[]
  parent          User?            @relation(fields: [parentId], references: [id])
  parentId        String?
  guardians       ChildGuardian[]
  formSubmissions FormSubmission[]
  enrollmentStartDate DateTime?
  enrollmentEndDate   DateTime?
  permissions     ChildPermission[]
  createdAt       DateTime         @default(now())
  OutboundEmail   OutboundEmail[]
  milestoneChecklistCompletions MilestoneChecklistItemCompletion[]
  behaviorPlans   BehaviorPlan[]
  childFlagReviews ChildFlagReview[]
  parentInvolvements ParentInvolvement[]
}

model ChildGuardian {
  id              String   @id @default(uuid())
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId         String
  guardian        User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  guardianId      String
  relationship    String?
  isPrimary       Boolean  @default(false)
  receivesUpdates Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([childId, guardianId])
  @@index([guardianId])
}

model LessonCategory {
  id          String   @id @default(uuid())
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId    String
  name        String
  description String?
  kind        String   @default("PACKAGE")
  groupName   String?
  ageRange    String?
  imageUrl    String?
  videoUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]
  dailyChecklistItems DailyChecklistItem[]

  @@index([centerId, name, ageRange])
  @@index([centerId, sortOrder])
}

model Lesson {
  id               String              @id @default(uuid())
  title            String
  description      String?
  subCategory      String?
  term             String?
  termDays         Int[]               @default([])
  lessonSlot       String?
  reference        String?
  center           Center              @relation(fields: [centerId], references: [id])
  centerId         String
  category         LessonCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       String?
  policyDocument   PolicyDocument?     @relation(fields: [policyDocumentId], references: [id], onDelete: SetNull)
  policyDocumentId String?
  linkedLesson     Lesson?             @relation("LessonLinkedLesson", fields: [linkedLessonId], references: [id], onDelete: SetNull)
  linkedLessonId   String?
  linkedFrom       Lesson[]            @relation("LessonLinkedLesson")
  media            String[]            @default([])
  goals            LessonGoal[]
  progress         Progress[]
  remediationsFrom LessonRemediation[] @relation("LessonRemediationsFrom")
  remediationsTo   LessonRemediation[] @relation("LessonRemediationsTo")
  milestoneChecklistItems MilestoneChecklistItem[]
  behaviorPlanGoals BehaviorPlanGoal[]
  supplies         LessonSupply[]
  dailyChecklistItems DailyChecklistItem[]

  @@index([policyDocumentId])
  @@index([linkedLessonId])
  @@index([centerId, term])
  @@index([centerId, lessonSlot])
}

model LessonTermCalendar {
  id        String   @id @default(uuid())
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId  String
  term      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, term])
  @@index([centerId, startDate, endDate])
}

model LessonGoal {
  id              String   @id @default(uuid())
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId        String
  goalIndex       Int
  title           String
  description     String?
  passingCriteria Json?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress Progress[]
  milestoneChecklistItems MilestoneChecklistItem[]

  @@unique([lessonId, goalIndex])
  @@index([lessonId, active])
}

model LessonRemediation {
  id           String   @id @default(uuid())
  fromLesson   Lesson   @relation("LessonRemediationsFrom", fields: [fromLessonId], references: [id], onDelete: Cascade)
  fromLessonId String
  toLesson     Lesson   @relation("LessonRemediationsTo", fields: [toLessonId], references: [id], onDelete: Cascade)
  toLessonId   String
  reason       String?
  createdAt    DateTime @default(now())

  @@unique([fromLessonId, toLessonId])
  @@index([fromLessonId])
  @@index([toLessonId])
}

model Progress {
  id             String          @id @default(uuid())
  child          Child           @relation(fields: [childId], references: [id])
  childId        String
  lesson         Lesson          @relation(fields: [lessonId], references: [id])
  lessonId       String
  status         ProgressStatus  @default(NOT_STARTED)
  goalIndex      Int             @default(1)
  lessonGoal     LessonGoal?     @relation(fields: [lessonGoalId], references: [id], onDelete: SetNull)
  lessonGoalId   String?
  achievedAt     DateTime?
  nextGoals      Progress[]      @relation("GoalProgression")
  previousGoal   Progress?       @relation("GoalProgression", fields: [previousGoalId], references: [id])
  previousGoalId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  entries        ProgressEntry[]

  @@unique([childId, lessonId, goalIndex])
  @@index([childId, status])
  @@index([lessonId, status])
}

model ProgressEntry {
  id           String         @id @default(uuid())
  progress     Progress       @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId   String
  status       ProgressStatus
  notes        String?
  details      Json?
  media        String[]       @default([])
  recordedBy   User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
  occurredAt   DateTime       @default(now())

  @@index([progressId, occurredAt])
  @@index([recordedById, occurredAt])
}

model ActivityLog {
  id           String       @id @default(uuid())
  child        Child        @relation(fields: [childId], references: [id])
  childId      String
  type         ActivityType @default(OTHER)
  details      Json?
  notes        String?
  recordedBy   User?        @relation(fields: [recordedById], references: [id])
  recordedById String?
  createdAt    DateTime     @default(now())
  isBackdated  Boolean      @default(false)
}

model Attendance {
  id           String    @id @default(uuid())
  day          DateTime
  center       Center    @relation(fields: [centerId], references: [id])
  centerId     String
  child        Child     @relation(fields: [childId], references: [id])
  childId      String
  classRoom    ClassRoom? @relation(fields: [classRoomId], references: [id])
  classRoomId  String?
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([childId, day])
  @@index([centerId, day])
  @@index([centerId, day, classRoomId])
}

model TaskChecklist {
  id          String   @id @default(uuid())
  title       String
  description String?
  center      Center   @relation(fields: [centerId], references: [id])
  centerId    String
  tasks       Task[]
  createdAt   DateTime @default(now())
}

model MilestoneChecklistPlan {
  id          String          @id @default(uuid())
  center      Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId    String
  classRoom   ClassRoom?      @relation(fields: [classRoomId], references: [id], onDelete: SetNull)
  classRoomId String?
  title       String
  description String?
  period      ChecklistPeriod
  periodStart DateTime
  active      Boolean         @default(true)
  items       MilestoneChecklistItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([centerId, period, periodStart, title, classRoomId])
  @@index([centerId, period, periodStart])
  @@index([centerId, classRoomId, period, periodStart])
}

model MilestoneChecklistItem {
  id               String                 @id @default(uuid())
  plan             MilestoneChecklistPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId           String
  sortOrder        Int                    @default(0)
  title            String
  kind             MilestoneItemKind      @default(OTHER)
  url              String?
  policyDocument   PolicyDocument?        @relation(fields: [policyDocumentId], references: [id], onDelete: SetNull)
  policyDocumentId String?
  lesson           Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId         String?
  lessonGoal       LessonGoal?            @relation(fields: [lessonGoalId], references: [id], onDelete: SetNull)
  lessonGoalId     String?
  notes            String?
  priority         Priority?
  dueAt            DateTime?
  assignedToId     String?
  assignedTo       User?                  @relation("ChecklistItemAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  completions      MilestoneChecklistItemCompletion[]
  staffCompletions MilestoneChecklistStaffCompletion[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([planId, sortOrder])
  @@index([lessonId])
  @@index([lessonGoalId])
  @@index([policyDocumentId])
  @@index([assignedToId])
  @@index([dueAt])
}

model MilestoneChecklistItemCompletion {
  id           String                 @id @default(uuid())
  item         MilestoneChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String
  child        Child                  @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId      String
  completedAt  DateTime?
  recordedBy   User?                  @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([childId, itemId])
  @@index([childId, completedAt])
  @@index([itemId, completedAt])
}

model MilestoneChecklistStaffCompletion {
  id            String                 @id @default(uuid())
  item          MilestoneChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId        String
  completedBy   User                   @relation("MilestoneChecklistStaffCompletedBy", fields: [completedById], references: [id], onDelete: Cascade)
  completedById String
  date          DateTime               @db.Date
  notes         String?
  completedAt   DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([itemId, completedById, date])
  @@index([itemId, date])
  @@index([completedById, date])
}

model ChildFlagReview {
  id         String   @id @default(uuid())
  center     Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId   String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId    String
  flagKey    String   @unique
  snapshot   Json?
  closedAt   DateTime?
  closedBy   User?    @relation("ChildFlagReviewClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([centerId, closedAt])
  @@index([childId, closedAt])
}

model Task {
  id          String        @id @default(uuid())
  title       String
  checklist   TaskChecklist @relation(fields: [checklistId], references: [id])
  checklistId String
  policyLink  String?
  mediaLink   String?
  taskTime    String?
  completed   ChildTask[]
  createdAt   DateTime      @default(now())
}

model ChildTask {
  id          String    @id @default(uuid())
  child       Child     @relation(fields: [childId], references: [id])
  childId     String
  task        Task      @relation(fields: [taskId], references: [id])
  taskId      String
  completedAt DateTime?

  @@unique([childId, taskId])
}

model Subscription {
  id          String    @id @default(uuid())
  center      Center    @relation(fields: [centerId], references: [id])
  centerId    String    @unique
  tier        String
  active      Boolean   @default(true)
  expiresAt   DateTime?
  paymentInfo Json?
}

model CenterInvite {
  id          String    @id @default(uuid())
  code        String    @unique
  center      Center    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId    String
  role        Role
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdBy   User?     @relation("InvitesCreated", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([centerId])
}

model MessageThread {
  id                  String               @id @default(uuid())
  center               Center?              @relation(fields: [centerId], references: [id])
  centerId             String?
  title                String?
  type                 MessageThreadType    @default(MESSAGE)
  status               MessageThreadStatus  @default(OPEN)
  priority             MessagePriorityLevel?
  dueDate              DateTime?
  createdBy            User                 @relation("MessageThreadsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdById          String
  completedBy          User?                @relation("MessageThreadsCompleted", fields: [completedById], references: [id], onDelete: SetNull)
  completedById        String?
  reviewRequestedBy    User?                @relation("MessageThreadsReviewRequested", fields: [reviewRequestedById], references: [id], onDelete: SetNull)
  reviewRequestedById  String?
  completedAt          DateTime?
  reviewRequestedAt    DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  participants ThreadParticipant[]
  messages     Message[]

  @@index([centerId, type, status])
  @@index([createdById, createdAt])
  @@index([completedAt])
  @@index([dueDate])
}

model ThreadParticipant {
  id        String        @id @default(uuid())
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime?
  createdAt  DateTime      @default(now())

  @@unique([threadId, userId])
}

model Message {
  id        String        @id @default(uuid())
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  createdAt DateTime      @default(now())
}

model FormTemplate {
  id                String   @id @default(uuid())
  center            Center?  @relation(fields: [centerId], references: [id])
  centerId          String?
  title             String
  description       String?
  targetRole        Role
  schema            Json?
  active            Boolean  @default(true)
  requiresRenewal   Boolean  @default(false)
  renewalPeriodDays Int?
  autoFillMapping   Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  submissions FormSubmission[]
}

model FormSubmission {
  id            String       @id @default(uuid())
  template      FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId    String
  submittedBy   User         @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  submittedById String
  child         Child?       @relation(fields: [childId], references: [id])
  childId       String?
  data          Json?
  status        String       @default("SUBMITTED")
  expiresAt     DateTime?
  renewedById   String?
  appliedToChild Boolean     @default(false)
  appliedAt     DateTime?
  appliedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  childPermissions ChildPermission[]
}

model PolicyDocument {
  id          String   @id @default(uuid())
  center      Center?  @relation(fields: [centerId], references: [id])
  centerId    String?
  title       String
  description String?
  url         String
