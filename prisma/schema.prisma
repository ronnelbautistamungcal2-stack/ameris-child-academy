generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  PARENT
  COACH
  SUBSCRIBER
}

enum ActivityType {
  DIAPER_CHANGE
  NAP
  BOTTLE
  MEAL
  SNACK
  ACTIVITY
  TASK_CHECKLIST
  BEHAVIOR
  OTHER
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
}

enum OutboundEmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELED
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  EMAIL_SENT
}

enum ChecklistPeriod {
  DAY
  WEEK
  MONTH
}

enum MilestoneItemKind {
  POLICY
  PROCEDURE
  VIDEO
  LESSON
  OTHER
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  name               String?
  password           String?
  dob                DateTime?
  hireDate           DateTime?
  aboutMe            String?
  pictureUrl         String?
  role               Role                @default(PARENT)
  centers            CenterUser[]
  children           Child[]
  guardianships      ChildGuardian[]
  teacherClasses     TeacherClass[]
  recordedActivities ActivityLog[]
  threadParticipants ThreadParticipant[]
  sentMessages       Message[]
  formSubmissions    FormSubmission[]
  createdInvites     CenterInvite[]      @relation("InvitesCreated")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ProgressEntry      ProgressEntry[]
  AuditLog           AuditLog[]
  OutboundEmail      OutboundEmail[]
  milestoneChecklistCompletions MilestoneChecklistItemCompletion[]
}

model Center {
  id               String           @id @default(uuid())
  name             String
  address          String?
  users            CenterUser[]
  classes          ClassRoom[]
  children         Child[]
  attendances      Attendance[]
  lessonCategories LessonCategory[]
  lessons          Lesson[]
  checklists       TaskChecklist[]
  subscription     Subscription?
  messageThreads   MessageThread[]
  formTemplates    FormTemplate[]
  policyDocuments  PolicyDocument[]
  invites          CenterInvite[]
  auditLogs        AuditLog[]
  outboundEmails   OutboundEmail[]
  milestoneChecklistPlans MilestoneChecklistPlan[]
  createdAt        DateTime         @default(now())
}

model CenterUser {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String
  center   Center @relation(fields: [centerId], references: [id])
  centerId String
  role     Role

  @@unique([userId, centerId])
}

model ClassRoom {
  id       String         @id @default(uuid())
  name     String
  capacity Int?
  ageRange String?
  center   Center         @relation(fields: [centerId], references: [id])
  centerId String
  children Child[]
  teachers TeacherClass[]
}

model TeacherClass {
  id        String    @id @default(uuid())
  teacher   User      @relation(fields: [teacherId], references: [id])
  teacherId String
  classRoom ClassRoom @relation(fields: [classId], references: [id])
  classId   String

  @@unique([teacherId, classId])
}

model Child {
  id              String           @id @default(uuid())
  firstName       String
  lastName        String?
  birthDate       DateTime?
  emergencyContact String?
  allergies       String?
  healthAssessmentDocuments Json?
  enrollmentDocuments Json?
  feedingPlan     Json?
  center          Center           @relation(fields: [centerId], references: [id])
  centerId        String
  classRoom       ClassRoom?       @relation(fields: [classRoomId], references: [id])
  classRoomId     String?
  progress        Progress[]
  activities      ActivityLog[]
  attendances     Attendance[]
  completedTasks  ChildTask[]
  parent          User?            @relation(fields: [parentId], references: [id])
  parentId        String?
  guardians       ChildGuardian[]
  formSubmissions FormSubmission[]
  createdAt       DateTime         @default(now())
  OutboundEmail   OutboundEmail[]
  milestoneChecklistCompletions MilestoneChecklistItemCompletion[]
}

model ChildGuardian {
  id              String   @id @default(uuid())
  child           Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId         String
  guardian        User     @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  guardianId      String
  relationship    String?
  isPrimary       Boolean  @default(false)
  receivesUpdates Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([childId, guardianId])
  @@index([guardianId])
}

model LessonCategory {
  id          String   @id @default(uuid())
  center      Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId    String
  name        String
  description String?
  kind        String   @default("PACKAGE")
  groupName   String?
  ageRange    String?
  imageUrl    String?
  videoUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@unique([centerId, name])
  @@index([centerId, sortOrder])
}

model Lesson {
  id               String              @id @default(uuid())
  title            String
  description      String?
  center           Center              @relation(fields: [centerId], references: [id])
  centerId         String
  category         LessonCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       String?
  media            String[]            @default([])
  goals            LessonGoal[]
  progress         Progress[]
  remediationsFrom LessonRemediation[] @relation("LessonRemediationsFrom")
  remediationsTo   LessonRemediation[] @relation("LessonRemediationsTo")
  milestoneChecklistItems MilestoneChecklistItem[]
}

model LessonGoal {
  id              String   @id @default(uuid())
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId        String
  goalIndex       Int
  title           String
  description     String?
  passingCriteria Json?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress Progress[]
  milestoneChecklistItems MilestoneChecklistItem[]

  @@unique([lessonId, goalIndex])
  @@index([lessonId, active])
}

model LessonRemediation {
  id           String   @id @default(uuid())
  fromLesson   Lesson   @relation("LessonRemediationsFrom", fields: [fromLessonId], references: [id], onDelete: Cascade)
  fromLessonId String
  toLesson     Lesson   @relation("LessonRemediationsTo", fields: [toLessonId], references: [id], onDelete: Cascade)
  toLessonId   String
  reason       String?
  createdAt    DateTime @default(now())

  @@unique([fromLessonId, toLessonId])
  @@index([fromLessonId])
  @@index([toLessonId])
}

model Progress {
  id             String          @id @default(uuid())
  child          Child           @relation(fields: [childId], references: [id])
  childId        String
  lesson         Lesson          @relation(fields: [lessonId], references: [id])
  lessonId       String
  status         ProgressStatus  @default(NOT_STARTED)
  goalIndex      Int             @default(1)
  lessonGoal     LessonGoal?     @relation(fields: [lessonGoalId], references: [id], onDelete: SetNull)
  lessonGoalId   String?
  achievedAt     DateTime?
  nextGoals      Progress[]      @relation("GoalProgression")
  previousGoal   Progress?       @relation("GoalProgression", fields: [previousGoalId], references: [id])
  previousGoalId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  entries        ProgressEntry[]

  @@unique([childId, lessonId, goalIndex])
  @@index([childId, status])
  @@index([lessonId, status])
}

model ProgressEntry {
  id           String         @id @default(uuid())
  progress     Progress       @relation(fields: [progressId], references: [id], onDelete: Cascade)
  progressId   String
  status       ProgressStatus
  notes        String?
  details      Json?
  media        String[]       @default([])
  recordedBy   User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
  occurredAt   DateTime       @default(now())

  @@index([progressId, occurredAt])
  @@index([recordedById, occurredAt])
}

model ActivityLog {
  id           String       @id @default(uuid())
  child        Child        @relation(fields: [childId], references: [id])
  childId      String
  type         ActivityType @default(OTHER)
  details      Json?
  notes        String?
  recordedBy   User?        @relation(fields: [recordedById], references: [id])
  recordedById String?
  createdAt    DateTime     @default(now())
  isBackdated  Boolean      @default(false)
}

model Attendance {
  id           String    @id @default(uuid())
  day          DateTime
  center       Center    @relation(fields: [centerId], references: [id])
  centerId     String
  child        Child     @relation(fields: [childId], references: [id])
  childId      String
  checkedInAt  DateTime?
  checkedOutAt DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([childId, day])
  @@index([centerId, day])
}

model TaskChecklist {
  id          String   @id @default(uuid())
  title       String
  description String?
  center      Center   @relation(fields: [centerId], references: [id])
  centerId    String
  tasks       Task[]
  createdAt   DateTime @default(now())
}

model MilestoneChecklistPlan {
  id          String          @id @default(uuid())
  center      Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId    String
  title       String
  description String?
  period      ChecklistPeriod
  periodStart DateTime
  active      Boolean         @default(true)
  items       MilestoneChecklistItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([centerId, period, periodStart, title])
  @@index([centerId, period, periodStart])
}

model MilestoneChecklistItem {
  id               String                 @id @default(uuid())
  plan             MilestoneChecklistPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId           String
  sortOrder        Int                    @default(0)
  title            String
  kind             MilestoneItemKind      @default(OTHER)
  url              String?
  policyDocument   PolicyDocument?        @relation(fields: [policyDocumentId], references: [id], onDelete: SetNull)
  policyDocumentId String?
  lesson           Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId         String?
  lessonGoal       LessonGoal?            @relation(fields: [lessonGoalId], references: [id], onDelete: SetNull)
  lessonGoalId     String?
  notes            String?
  completions      MilestoneChecklistItemCompletion[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([planId, sortOrder])
  @@index([lessonId])
  @@index([lessonGoalId])
  @@index([policyDocumentId])
}

model MilestoneChecklistItemCompletion {
  id           String                 @id @default(uuid())
  item         MilestoneChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId       String
  child        Child                  @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId      String
  completedAt  DateTime?
  recordedBy   User?                  @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([childId, itemId])
  @@index([childId, completedAt])
  @@index([itemId, completedAt])
}

model Task {
  id          String        @id @default(uuid())
  title       String
  checklist   TaskChecklist @relation(fields: [checklistId], references: [id])
  checklistId String
  policyLink  String?
  mediaLink   String?
  completed   ChildTask[]
  createdAt   DateTime      @default(now())
}

model ChildTask {
  id          String    @id @default(uuid())
  child       Child     @relation(fields: [childId], references: [id])
  childId     String
  task        Task      @relation(fields: [taskId], references: [id])
  taskId      String
  completedAt DateTime?

  @@unique([childId, taskId])
}

model Subscription {
  id          String    @id @default(uuid())
  center      Center    @relation(fields: [centerId], references: [id])
  centerId    String    @unique
  tier        String
  active      Boolean   @default(true)
  expiresAt   DateTime?
  paymentInfo Json?
}

model CenterInvite {
  id          String    @id @default(uuid())
  code        String    @unique
  center      Center    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId    String
  role        Role
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdBy   User?     @relation("InvitesCreated", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([centerId])
}

model MessageThread {
  id        String   @id @default(uuid())
  center    Center?  @relation(fields: [centerId], references: [id])
  centerId  String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ThreadParticipant[]
  messages     Message[]
}

model ThreadParticipant {
  id        String        @id @default(uuid())
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime      @default(now())

  @@unique([threadId, userId])
}

model Message {
  id        String        @id @default(uuid())
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  String
  body      String
  createdAt DateTime      @default(now())
}

model FormTemplate {
  id          String   @id @default(uuid())
  center      Center?  @relation(fields: [centerId], references: [id])
  centerId    String?
  title       String
  description String?
  targetRole  Role
  schema      Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions FormSubmission[]
}

model FormSubmission {
  id            String       @id @default(uuid())
  template      FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId    String
  submittedBy   User         @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  submittedById String
  child         Child?       @relation(fields: [childId], references: [id])
  childId       String?
  data          Json?
  status        String       @default("SUBMITTED")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model PolicyDocument {
  id          String   @id @default(uuid())
  center      Center?  @relation(fields: [centerId], references: [id])
  centerId    String?
  title       String
  description String?
  url         String
  roles       Role[]
  createdAt   DateTime @default(now())
  milestoneChecklistItems MilestoneChecklistItem[]
}

model AuditLog {
  id         String      @id @default(uuid())
  center     Center?     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId   String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([centerId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model OutboundEmail {
  id          String              @id @default(uuid())
  center      Center?             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  centerId    String?
  child       Child?              @relation(fields: [childId], references: [id], onDelete: SetNull)
  childId     String?
  createdBy   User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  to          String
  cc          String[]            @default([])
  bcc         String[]            @default([])
  subject     String
  template    String?
  payload     Json?
  status      OutboundEmailStatus @default(QUEUED)
  scheduledAt DateTime            @default(now())
  sentAt      DateTime?
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, scheduledAt])
  @@index([centerId, createdAt])
  @@index([childId, createdAt])
}
